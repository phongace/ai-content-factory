# Copy to .env.local and fill in. Never commit real values.

# Where projects, renders, tokens live (default ./data, gitignored)
DATA_DIR=

# ---------- Planner ----------
# auto = Claude if ANTHROPIC_API_KEY is set, else mock. Force with: claude | mock
PLANNER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# USD per million tokens, only for cost estimates (check current pricing)
ANTHROPIC_INPUT_PRICE_PER_MTOK=2
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=10

# ---------- Voice ----------
# mock | edge (dev only, no clear commercial license) | voicestudio
VOICE_PROVIDER=mock
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900/v1
# voice: a profile id/name from GET /v1/audio/voices, or default
VOICESTUDIO_VOICE=default
# model: an engine id (omnivoice, kittentts, ...) or tts-1 for the engine active in the app.
# omnivoice weights are CC-BY-NC: not for monetized videos.
VOICESTUDIO_MODEL=tts-1
VOICESTUDIO_API_KEY=local
# seconds per scene request; CPU-only backends are ~30x slower than real time
VOICESTUDIO_TIMEOUT=900
EDGE_VOICE_VI=vi-VN-HoaiMyNeural
EDGE_VOICE_EN=en-US-AndrewNeural
# USD per second of generated audio (0 for local models)
VOICE_COST_PER_SECOND=0

# ---------- Muse (manual in POC) ----------
# Added to project cost each time a clip is attached. Editable per project in the UI.
MUSE_COST_PER_CLIP=0

# ---------- Background music (optional) ----------
# Default royalty-free track used when the UI/CLI does not pass one
BGM_FILE=
BGM_VOLUME=0.25

# ---------- YouTube Data API (OAuth Desktop client) ----------
# Primary: the Desktop-app client JSON downloaded from Google Cloud Console (gitignored, keep mode 600).
# Relative paths resolve against the repo root. Default: <DATA_DIR>/secrets/youtube_client_secret.json
YOUTUBE_CLIENT_SECRET_FILE=data/secrets/youtube_client_secret.json
# Fallback only, used when the file above does not exist
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------- FFmpeg (set both when the PATH ffmpeg lacks libass, see docs/POC_RUNBOOK.md) ----------
FFMPEG_PATH=
FFPROBE_PATH=
